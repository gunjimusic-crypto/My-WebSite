---
// Static root. Redirects the visitor to /ja/ or /en/ based on their browser
// language, client-side. <noscript> and meta-refresh fall back to /ja/.
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta http-equiv="refresh" content="0; url=/ja/" />
  <title>Nari-Aki Gunji</title>
  <script is:inline>
    (function () {
      var l = (navigator.language || 'ja').toLowerCase();
      location.replace(l.indexOf('ja') === 0 ? '/ja/' : '/en/');
    })();
  </script>
</head>
<body></body>
</html>
