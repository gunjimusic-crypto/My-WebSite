---
import Base from '../../layouts/Base.astro';
import { ui } from '../../i18n/ui.js';
export function getStaticPaths() {
  return [{ params: { lang: 'en' } }];
}
const { lang } = Astro.params;
const t = ui[lang];
---
<Base lang={lang} page="" title={t.meta.homeTitle}>
  <div class="hero">
    <div class="wrap hero-grid">
      <div class="hero-left">
        <div class="hero-coords mono-sm">N 35°41′ · E 139°41′ — Tokyo</div>
        <h1><span class="n">Nari-Aki</span><span class="g">Gu<em>n</em>ji</span></h1>
        <p class="hero-sub">{t.hero.subLines.map((line, i) => (<Fragment>{i > 0 && <br />}{line}</Fragment>))}</p>
        <div class="hero-tags kicker">
          {t.hero.tags.map((tag) => <span>{tag}</span>)}
        </div>
      </div>
      <div class="hero-right">
        <div class="hero-photo">
          <img class="hero-img" src="/photos/portrait.jpg" alt="Nari-Aki Gunji" />
          <svg class="pcorner reg" viewBox="0 0 14 14"><line x1="0" y1="7" x2="14" y2="7"/><line x1="7" y1="0" x2="7" y2="14"/><circle cx="7" cy="7" r="4"/></svg>
        </div>
      </div>
    </div>
  </div>

  <div class="artband" id="artband">
    <svg class="art-svg" viewBox="0 0 1200 460" preserveAspectRatio="xMidYMid slice" fill="none">
      <defs>
        <filter id="grain"><feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" stitchTiles="stitch"/><feColorMatrix type="saturate" values="0"/><feComponentTransfer><feFuncA type="linear" slope="0.05"/></feComponentTransfer><feComposite operator="over" in2="SourceGraphic"/></filter>
      </defs>
      <rect x="0" y="0" width="1200" height="460" fill="#E1DDD3"/>
      <rect x="60" y="60" width="360" height="300" fill="#5F6E77" opacity=".06"/>
      <rect x="820" y="40" width="300" height="380" fill="#B7A57E" opacity=".08"/>
      <path d="M760 460 A 300 300 0 0 1 1160 120" stroke="#5F6E77" stroke-width="1" opacity=".4"/>
      <ellipse cx="300" cy="230" rx="220" ry="220" stroke="#1B1A17" stroke-width="1" opacity=".14"/>
      <line x1="0" y1="250" x2="1200" y2="250" stroke="#9C9A90" stroke-width="1" opacity=".4"/>
      <line x1="0" y1="300" x2="1200" y2="300" stroke="#CBC7BC" stroke-width="1" opacity=".6"/>
      <path d="M0 330 C 260 260, 520 300, 760 250 S 1040 200, 1200 240" stroke="#1B1A17" stroke-width="1" opacity=".3"/>
      <g id="art-lines"></g>
      <g id="art-dots"></g>
      <rect x="940" y="300" width="120" height="120" fill="#5F6E77" opacity=".5"/>
      <rect x="1000" y="330" width="120" height="120" fill="#1B1A17" opacity=".45"/>
      <rect x="900" y="350" width="70" height="70" fill="#B7A57E" opacity=".6"/>
      <line x1="470" y1="150" x2="640" y2="150" stroke="#AE3B2C" stroke-width="1.5" opacity=".85"/>
      <circle cx="470" cy="150" r="3.5" fill="#AE3B2C"/>
      <g opacity=".85">
        <line x1="150" y1="380" x2="180" y2="380" stroke="#AE3B2C" stroke-width="1"/>
        <line x1="165" y1="365" x2="165" y2="395" stroke="#AE3B2C" stroke-width="1"/>
        <circle cx="165" cy="380" r="9" stroke="#AE3B2C" stroke-width="1" fill="none"/>
      </g>
      <rect x="0" y="0" width="1200" height="460" filter="url(#grain)" opacity=".5"/>
    </svg>
    <div class="art-plate mono-sm"><span class="rednum">PL. 02</span>{' '}— untitled study, mixed media</div>
    <svg class="art-cross reg" viewBox="0 0 14 14"><line x1="0" y1="7" x2="14" y2="7"/><line x1="7" y1="0" x2="7" y2="14"/><circle cx="7" cy="7" r="4"/></svg>
  </div>

  <a class="biolead" href={`/${lang}/bio/`}>
    <div class="wrap biolead-in">
      <div class="biolead-art" id="biolead-art"></div>
      <div class="biolead-txt">
        <div class="eyebrow">{t.bioLead.eyebrow}</div>
        <h2>{t.bioLead.h2}</h2>
        <p>{t.bioLead.p}</p>
        <span class="link-more">{t.bioLead.link}<span class="ar"></span></span>
      </div>
    </div>
  </a>
  {/* Latest-note block hidden until real notes are published in microCMS. */}
</Base>

<script>
  import { albumArt, populateArtband, initReveal } from '../../scripts/art.js';
  const bl = document.getElementById('biolead-art');
  if (bl) bl.innerHTML = albumArt('about-nari');
  populateArtband();
  initReveal('#artband');
</script>
