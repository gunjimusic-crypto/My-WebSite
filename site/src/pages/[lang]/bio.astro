---
import Base from '../../layouts/Base.astro';
import { ui } from '../../i18n/ui.js';
export function getStaticPaths() {
  return [{ params: { lang: 'ja' } }, { params: { lang: 'en' } }];
}
const { lang } = Astro.params;
const t = ui[lang];
const arrow = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M7 17L17 7M17 7H9M17 7v8"/></svg>';
const links = [
  { n: '01', label: 'YouTube', href: '#' },
  { n: '02', label: 'Spotify', href: '#' },
  { n: '03', label: 'Apple Music', href: '#' },
  { n: '04', label: 'X / Twitter', href: '#' }
];
---
<Base lang={lang} page="bio" title={t.meta.bioTitle}>
  <div class="wrap sec-pad">
    <div class="eyebrow">{t.bio.eyebrow}</div>
    <div class="bio-grid">
      <div class="portrait">
        <img class="portrait-img" src="/photos/portrait.jpg" alt="Nari-Aki Gunji" />
      </div>
      <div class="bio-body">
        <div class="bio-head">
          <h2 class="bio-name">{t.bio.name}</h2>
          <div class="bio-meta mono-sm"><span id="bio-age" data-prefix={t.bio.agePrefix} data-suffix={t.bio.ageSuffix}></span>{t.bio.metaBorn}</div>
        </div>
        <p>{t.bio.p1}</p>
        <p>{t.bio.p2}</p>
        <p>{t.bio.p3}</p>
        <div class="links">
          {links.map((l) => (
            <a class="link-row" href={l.href}>
              <span class="lk-name"><span class="mono">{l.n}</span><span class="lk-label">{l.label}</span></span>
              <span class="lk-ext"><Fragment set:html={arrow} /></span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</Base>

<script>
  // Auto-calculate age from date of birth (2004-04-15) so it never goes stale.
  var dob = new Date(2004, 3, 15);
  var now = new Date();
  var age = now.getFullYear() - dob.getFullYear();
  var m = now.getMonth() - dob.getMonth();
  if (m < 0 || (m === 0 && now.getDate() < dob.getDate())) age--;
  var el = document.getElementById('bio-age');
  if (el) el.textContent = (el.dataset.prefix || '') + age + (el.dataset.suffix || '');
</script>
